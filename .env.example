# ==============================================================================
# PathForge AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running services.
# NEVER commit real credentials, tokens, or secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Web Application
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Primary Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathforge_dev?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pathforge_dev
POSTGRES_PORT=5432

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_SERVICE_API_KEY=your_internal_ai_service_api_key_placeholder

# External AI Providers (Kept server-side only)
OPENAI_API_KEY=your_openai_api_key_placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder

# Authentication & Security
JWT_SECRET=your_jwt_secret_placeholder_min_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
