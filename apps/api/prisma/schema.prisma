generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(uuid())
  email     String          @unique
  name      String
  profile   LearnerProfile?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model LearnerProfile {
  id                    String               @id @default(uuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole            String
  careerGoalDescription String?
  targetIndustry        String?
  targetCompanyType     String?
  targetTimeline        String?
  educationLevel        String?
  fieldOfStudy          String?
  experienceYears       Float?
  professionalSummary   String?
  technicalLevel        String               @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED, PROFESSIONAL
  skills                LearnerSkill[]
  projects              Project[]
  learningExperiences   LearningExperience[]
  certifications        Certification[]
  interests             LearnerInterest[]
  preference            LearningPreference?
  gapAnalyses           SkillGapAnalysis[]
  recommendations       Recommendation[]
  learningPaths         LearningPath[]
  resourceProgress      ResourceProgress[]
  skillEvidence         SkillEvidence[]
  skillStates           SkillState[]
  assessmentAttempts    AssessmentAttempt[]
  learningFeedbacks     LearningFeedback[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model LearnerSkill {
  id                String         @id @default(uuid())
  profileId         String
  profile           LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name              String
  normalizedName    String
  selfReportedLevel Int            @default(3) // 1 to 5
  yearsExperience   Float?
  confidence        Int?           @default(3) // 1 to 5
  evidence          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([profileId, normalizedName])
  @@index([profileId])
}

model Project {
  id             String         @id @default(uuid())
  profileId      String
  profile        LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String
  description    String
  technologies   String         // JSON array of strings: e.g. ["React", "Node.js"]
  role           String?
  durationMonths Int?
  projectUrl     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([profileId])
}

model LearningExperience {
  id             String         @id @default(uuid())
  profileId      String
  profile        LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseName     String
  provider       String         // Coursera, Udemy, edX, University, Self-Taught
  subject        String?
  status         String         @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, DROPPED
  completionDate DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([profileId])
}

model Certification {
  id            String         @id @default(uuid())
  profileId     String
  profile       LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name          String
  issuer        String         // AWS, Google, Microsoft, Meta, etc.
  issueDate     DateTime?
  credentialUrl String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([profileId])
}

model LearnerInterest {
  id        String         @id @default(uuid())
  profileId String
  profile   LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category  String         @default("TECHNICAL") // TECHNICAL, INDUSTRY, CAREER
  topic     String
  createdAt DateTime       @default(now())

  @@index([profileId])
}

model LearningPreference {
  id                      String         @id @default(uuid())
  profileId               String         @unique
  profile                 LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  learningFormat          String         @default("MIXED") // VISUAL, READING, HANDS_ON, MIXED
  difficultyPreference    String         @default("CHALLENGING") // GENTLE, MODERATE, CHALLENGING, INTENSIVE
  weeklyAvailabilityHours String         @default("10-15") // 0-5, 5-10, 10-15, 15-20, 20+
  projectPreference       String         @default("BALANCED") // PRACTICAL_PROJECTS, THEORY_FIRST, BALANCED
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

// ==============================================================================
// PHASE 2: CAREER & SKILL INTELLIGENCE FOUNDATION
// ==============================================================================

model Career {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  description       String
  category          String             // Engineering, Data & AI, DevOps & Cloud, Security, Quality Assurance, Product & Analytics
  difficulty        String             @default("INTERMEDIATE") // ENTRY, INTERMEDIATE, ADVANCED
  typicalExperience String?            // e.g. "0-2 years", "2-4 years", "3-5 years", "5+ years"
  demandLevel       String             @default("HIGH") // HIGH, VERY_HIGH, MODERATE
  isActive          Boolean            @default(true)
  skills            CareerSkill[]
  gapAnalyses       SkillGapAnalysis[]
  recommendations   Recommendation[]
  learningPaths     LearningPath[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([category])
  @@index([slug])
}

model Skill {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  description           String
  category              String                 // Programming, Frontend, Backend, Database, Cloud, DevOps, AI/ML, Data, Security, Architecture, Tools, Soft Skills
  aliases               String                 @default("[]") // JSON stringified array of aliases (e.g. ["JS", "Javascript"])
  skillType             String                 @default("Technical") // Technical, Tool, Concept, SoftSkill
  isActive              Boolean                @default(true)
  careerSkills          CareerSkill[]
  prerequisites         SkillPrerequisite[]    @relation("SkillToPrerequisites") // Skills that THIS skill requires
  dependents            SkillPrerequisite[]    @relation("PrerequisiteToSkills") // Skills that require THIS skill
  gapResults            SkillGapResult[]
  resourceSkills        ResourceSkill[]
  resourcePrerequisites ResourcePrerequisite[]
  recommendations       Recommendation[]
  milestoneSkills       MilestoneSkill[]
  skillEvidence         SkillEvidence[]
  skillStates           SkillState[]
  assessmentSkills      AssessmentSkill[]
  assessmentQuestions   AssessmentQuestion[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([category])
  @@index([slug])
  @@index([skillType])
}

model CareerSkill {
  id            String   @id @default(uuid())
  careerId      String
  career        Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  importance    String   @default("HIGH") // CORE, HIGH, MEDIUM, OPTIONAL
  requiredLevel Int      @default(3) // 1 to 5: 1=Beginner, 2=Basic, 3=Intermediate, 4=Advanced, 5=Expert
  priority      Int      @default(1)
  rationale     String?
  isCore        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([careerId, skillId])
  @@index([careerId])
  @@index([skillId])
  @@index([importance])
}

model SkillPrerequisite {
  id                  String   @id @default(uuid())
  skillId             String
  skill               Skill    @relation("SkillToPrerequisites", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisiteSkillId String
  prerequisiteSkill   Skill    @relation("PrerequisiteToSkills", fields: [prerequisiteSkillId], references: [id], onDelete: Cascade)
  strength            String   @default("REQUIRED") // REQUIRED, RECOMMENDED, HELPFUL
  rationale           String?
  createdAt           DateTime @default(now())

  @@unique([skillId, prerequisiteSkillId])
  @@index([skillId])
  @@index([prerequisiteSkillId])
}

// ==============================================================================
// PHASE 3: PERSONALIZED SKILL GAP INTELLIGENCE ENGINE
// ==============================================================================

model SkillGapAnalysis {
  id               String           @id @default(uuid())
  userId           String
  learnerProfileId String
  learnerProfile   LearnerProfile   @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  careerId         String
  career           Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)
  readinessScore   Float            // 0.0 to 100.0 alignment percentage
  readinessBand    String           // Starting Point, Early Development, Developing, Strong Progress, Career Ready
  algorithmVersion String           @default("v1")
  summary          String?
  stats            String?          // JSON stringified summary counts
  results          SkillGapResult[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([learnerProfileId])
  @@index([careerId])
}

model SkillGapResult {
  id                    String           @id @default(uuid())
  analysisId            String
  analysis              SkillGapAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  skillId               String
  skill                 Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  learnerLevel          Int              // 0 to 5
  requiredLevel         Int              // 1 to 5
  gap                   Int              // max(0, requiredLevel - learnerLevel)
  gapSeverity           Float            // 0.0 to 1.0
  importance            String           // CORE, HIGH, MEDIUM, OPTIONAL
  priorityScore         Float            // 0.0 to 1.0
  readiness             String           // READY, PARTIALLY_READY, BLOCKED
  category              String           // STRENGTH, DEVELOPING, MISSING
  isCritical            Boolean          @default(false)
  explanation           String
  downstreamImpactCount Int              @default(0)
  createdAt             DateTime         @default(now())

  @@index([analysisId])
  @@index([skillId])
}

// ==============================================================================
// PHASE 4: INTELLIGENT LEARNING RESOURCE RECOMMENDATION ENGINE
// ==============================================================================

model LearningResource {
  id             String                 @id @default(uuid())
  title          String
  slug           String                 @unique
  description    String
  resourceType   String                 // COURSE, PROJECT, ARTICLE, DOCUMENTATION, VIDEO, BOOK, EXERCISE
  provider       String                 // e.g., MDN, Spring.io, freeCodeCamp, MIT OCW, Coursera
  url            String                 // Realistic canonical educational link
  difficulty     String                 // BEGINNER, INTERMEDIATE, ADVANCED
  estimatedHours Float                  @default(5.0)
  language       String                 @default("en")
  isFree         Boolean                @default(true)
  qualityScore   Float                  @default(0.85) // Internal curated quality score 0.0 to 1.0
  embedding      String?                // JSON stringified float[] vector
  isActive       Boolean                @default(true)
  skills         ResourceSkill[]
  prerequisites  ResourcePrerequisite[]
  recommendations Recommendation[]
  milestoneResources MilestoneResource[]
  resourceProgress ResourceProgress[]
  feedbacks      LearningFeedback[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([resourceType])
  @@index([difficulty])
  @@index([isFree])
  @@index([isActive])
}

model ResourceSkill {
  id         String           @id @default(uuid())
  resourceId String
  resource   LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  coverage   String           @default("PRIMARY") // PRIMARY, SUPPORTING, MENTIONED
  createdAt  DateTime         @default(now())

  @@unique([resourceId, skillId])
  @@index([resourceId])
  @@index([skillId])
  @@index([coverage])
}

model ResourcePrerequisite {
  id            String           @id @default(uuid())
  resourceId    String
  resource      LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  requiredLevel Int              @default(2) // Minimum level (1-5) required for this resource
  createdAt     DateTime         @default(now())

  @@unique([resourceId, skillId])
  @@index([resourceId])
  @@index([skillId])
}

model Recommendation {
  id                 String           @id @default(uuid())
  userId             String
  learnerProfileId   String
  learnerProfile     LearnerProfile   @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  careerId           String
  career             Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  resourceId         String
  resource           LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  semanticScore      Float            // 0.0 to 1.0
  coverageScore      Float            // 0.0 to 1.0
  careerScore        Float            // 0.0 to 1.0
  difficultyScore    Float            // 0.0 to 1.0
  prerequisiteScore  Float            // 0.0 to 1.0
  preferenceScore    Float            // 0.0 to 1.0
  qualityScore       Float            // 0.0 to 1.0
  finalScore         Float            // 0.0 to 1.0
  matchPercentage    Int              // 0 to 100
  rank               Int              // 1, 2, 3...
  explanation        String           // JSON stringified string[]
  isSemanticFallback Boolean          @default(false)
  algorithmVersion   String           @default("recommendation-v1")
  createdAt          DateTime         @default(now())

  @@index([userId])
  @@index([learnerProfileId])
  @@index([careerId])
  @@index([skillId])
  @@index([resourceId])
}

// ==============================================================================
// PHASE 5: PERSONALIZED LEARNING PATH & ROADMAP GENERATOR
// ==============================================================================

model LearningPath {
  id                    String              @id @default(uuid())
  userId                String
  learnerProfileId      String
  learnerProfile        LearnerProfile      @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  careerId              String
  career                Career              @relation(fields: [careerId], references: [id], onDelete: Cascade)
  title                 String
  description           String
  readinessAtGeneration Float               @default(0.0) // Readiness score (0 to 100)
  estimatedHours        Float               @default(0.0)
  estimatedWeeks        Int                 @default(1)
  weeklyHours           Float               @default(10.0)
  status                String              @default("ACTIVE") // ACTIVE, ARCHIVED, COMPLETED
  algorithmVersion      String              @default("path-v1")
  whyThisOrderOverview  String?             // JSON stringified string[]
  milestones            LearningMilestone[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([learnerProfileId])
  @@index([careerId])
  @@index([status])
}

model LearningMilestone {
  id                 String              @id @default(uuid())
  learningPathId     String
  learningPath       LearningPath        @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  title              String
  description        String
  order              Int                 // 1, 2, 3...
  estimatedHours     Float               @default(0.0)
  estimatedWeeks     Int                 @default(1)
  learningObjectives String              // JSON stringified string[]
  completionCriteria String              // JSON stringified string[]
  whyThisOrder       String?             // Structured explanation of why this milestone is positioned here
  status             String              @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  skills             MilestoneSkill[]
  resources          MilestoneResource[]
  feedbacks          LearningFeedback[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([learningPathId])
  @@index([order])
  @@index([status])
}

model MilestoneSkill {
  id          String            @id @default(uuid())
  milestoneId String
  milestone   LearningMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  targetLevel Int               @default(3) // Target level 1-5
  order       Int               @default(1)
  createdAt   DateTime          @default(now())

  @@unique([milestoneId, skillId])
  @@index([milestoneId])
  @@index([skillId])
}

model MilestoneResource {
  id             String            @id @default(uuid())
  milestoneId    String
  milestone      LearningMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  resourceId     String
  resource       LearningResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  order          Int               @default(1)
  role           String            @default("PRIMARY") // PRIMARY, SUPPORTING, PRACTICE, PROJECT
  estimatedHours Float             @default(5.0)
  createdAt      DateTime          @default(now())

  @@unique([milestoneId, resourceId])
  @@index([milestoneId])
  @@index([resourceId])
  @@index([role])
}

// ==============================================================================
// PHASE 6: PROGRESS TRACKING, ASSESSMENTS & ADAPTIVE LEARNING ENGINE
// ==============================================================================

model ResourceProgress {
  id                 String           @id @default(uuid())
  learnerProfileId   String
  learnerProfile     LearnerProfile   @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  resourceId         String
  resource           LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  status             String           @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, SKIPPED
  progressPercent    Float            @default(0.0) // 0.0 to 100.0
  startedAt          DateTime?
  completedAt        DateTime?
  timeSpentMinutes   Float            @default(0.0)
  lastAccessedAt     DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([learnerProfileId, resourceId])
  @@index([learnerProfileId])
  @@index([resourceId])
  @@index([status])
}

model SkillEvidence {
  id               String         @id @default(uuid())
  learnerProfileId String
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  evidenceType     String         // SELF_REPORTED, RESOURCE_COMPLETION, ASSESSMENT, PROJECT, USER_FEEDBACK
  sourceId         String?        // e.g. assessmentAttemptId or resourceId
  score            Float          @default(0.0) // 0.0 to 100.0
  confidence       Float          @default(0.5) // 0.0 to 1.0
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([learnerProfileId])
  @@index([skillId])
  @@index([evidenceType])
}

model SkillState {
  id               String         @id @default(uuid())
  learnerProfileId String
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  inferredLevel    Int            @default(1) // 1 to 5
  confidence       Float          @default(0.35) // 0.0 to 1.0
  evidenceScore    Float          @default(0.0) // 0.0 to 100.0
  status           String         @default("NEEDS_WORK") // NEEDS_WORK, DEVELOPING, SATISFIED, MASTERED
  lastAssessedAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([learnerProfileId, skillId])
  @@index([learnerProfileId])
  @@index([skillId])
  @@index([status])
}

model Assessment {
  id               String               @id @default(uuid())
  title            String
  slug             String               @unique
  description      String
  difficulty       String               @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  estimatedMinutes Int                  @default(15)
  passingScore     Int                  @default(70) // 0 to 100
  isActive         Boolean              @default(true)
  skills           AssessmentSkill[]
  questions        AssessmentQuestion[]
  attempts         AssessmentAttempt[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([slug])
  @@index([difficulty])
  @@index([isActive])
}

model AssessmentSkill {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([assessmentId, skillId])
  @@index([assessmentId])
  @@index([skillId])
}

model AssessmentQuestion {
  id             String             @id @default(uuid())
  assessmentId   String
  assessment     Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question       String
  questionType   String             @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE
  options        String             // JSON stringified string[] array of choices
  correctAnswer  Int                @default(0) // 0-based index of correct option
  explanation    String             // Factual pedagogical explanation
  difficulty     String             @default("INTERMEDIATE")
  skillId        String
  skill          Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  order          Int                @default(1)
  answers        AssessmentAnswer[]
  createdAt      DateTime           @default(now())

  @@index([assessmentId])
  @@index([skillId])
  @@index([order])
}

model AssessmentAttempt {
  id               String             @id @default(uuid())
  learnerProfileId String
  learnerProfile   LearnerProfile     @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  assessmentId     String
  assessment       Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score            Float              @default(0.0) // 0.0 to 100.0
  passed           Boolean            @default(false)
  startedAt        DateTime           @default(now())
  completedAt      DateTime           @default(now())
  timeSpentSeconds Int                @default(0)
  answers          AssessmentAnswer[]
  createdAt        DateTime           @default(now())

  @@index([learnerProfileId])
  @@index([assessmentId])
  @@index([passed])
}

model AssessmentAnswer {
  id             String             @id @default(uuid())
  attemptId      String
  attempt        AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer Int                // 0-based index selected by learner
  isCorrect      Boolean            @default(false)
  createdAt      DateTime           @default(now())

  @@index([attemptId])
  @@index([questionId])
}

model LearningFeedback {
  id               String             @id @default(uuid())
  learnerProfileId String
  learnerProfile   LearnerProfile     @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  resourceId       String?
  resource         LearningResource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  milestoneId      String?
  milestone        LearningMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  feedbackType     String             // TOO_EASY, JUST_RIGHT, TOO_DIFFICULT, NOT_RELEVANT, ALREADY_KNOWN, VERY_USEFUL
  rating           Int?               // 1 to 5
  comment          String?
  createdAt        DateTime           @default(now())

  @@index([learnerProfileId])
  @@index([resourceId])
  @@index([milestoneId])
  @@index([feedbackType])
}



