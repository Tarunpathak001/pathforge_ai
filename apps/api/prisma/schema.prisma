generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(uuid())
  email     String          @unique
  name      String
  profile   LearnerProfile?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model LearnerProfile {
  id                    String               @id @default(uuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole            String
  careerGoalDescription String?
  targetIndustry        String?
  targetCompanyType     String?
  targetTimeline        String?
  educationLevel        String?
  fieldOfStudy          String?
  experienceYears       Float?
  professionalSummary   String?
  technicalLevel        String               @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED, PROFESSIONAL
  skills                LearnerSkill[]
  projects              Project[]
  learningExperiences   LearningExperience[]
  certifications        Certification[]
  interests             LearnerInterest[]
  preference            LearningPreference?
  gapAnalyses           SkillGapAnalysis[]
  recommendations       Recommendation[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model LearnerSkill {
  id                String         @id @default(uuid())
  profileId         String
  profile           LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name              String
  normalizedName    String
  selfReportedLevel Int            @default(3) // 1 to 5
  yearsExperience   Float?
  confidence        Int?           @default(3) // 1 to 5
  evidence          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([profileId, normalizedName])
  @@index([profileId])
}

model Project {
  id             String         @id @default(uuid())
  profileId      String
  profile        LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String
  description    String
  technologies   String         // JSON array of strings: e.g. ["React", "Node.js"]
  role           String?
  durationMonths Int?
  projectUrl     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([profileId])
}

model LearningExperience {
  id             String         @id @default(uuid())
  profileId      String
  profile        LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseName     String
  provider       String         // Coursera, Udemy, edX, University, Self-Taught
  subject        String?
  status         String         @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, DROPPED
  completionDate DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([profileId])
}

model Certification {
  id            String         @id @default(uuid())
  profileId     String
  profile       LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name          String
  issuer        String         // AWS, Google, Microsoft, Meta, etc.
  issueDate     DateTime?
  credentialUrl String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([profileId])
}

model LearnerInterest {
  id        String         @id @default(uuid())
  profileId String
  profile   LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category  String         @default("TECHNICAL") // TECHNICAL, INDUSTRY, CAREER
  topic     String
  createdAt DateTime       @default(now())

  @@index([profileId])
}

model LearningPreference {
  id                      String         @id @default(uuid())
  profileId               String         @unique
  profile                 LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  learningFormat          String         @default("MIXED") // VISUAL, READING, HANDS_ON, MIXED
  difficultyPreference    String         @default("CHALLENGING") // GENTLE, MODERATE, CHALLENGING, INTENSIVE
  weeklyAvailabilityHours String         @default("10-15") // 0-5, 5-10, 10-15, 15-20, 20+
  projectPreference       String         @default("BALANCED") // PRACTICAL_PROJECTS, THEORY_FIRST, BALANCED
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

// ==============================================================================
// PHASE 2: CAREER & SKILL INTELLIGENCE FOUNDATION
// ==============================================================================

model Career {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  description       String
  category          String             // Engineering, Data & AI, DevOps & Cloud, Security, Quality Assurance, Product & Analytics
  difficulty        String             @default("INTERMEDIATE") // ENTRY, INTERMEDIATE, ADVANCED
  typicalExperience String?            // e.g. "0-2 years", "2-4 years", "3-5 years", "5+ years"
  demandLevel       String             @default("HIGH") // HIGH, VERY_HIGH, MODERATE
  isActive          Boolean            @default(true)
  skills            CareerSkill[]
  gapAnalyses       SkillGapAnalysis[]
  recommendations   Recommendation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([category])
  @@index([slug])
}

model Skill {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  description           String
  category              String                 // Programming, Frontend, Backend, Database, Cloud, DevOps, AI/ML, Data, Security, Architecture, Tools, Soft Skills
  aliases               String                 @default("[]") // JSON stringified array of aliases (e.g. ["JS", "Javascript"])
  skillType             String                 @default("Technical") // Technical, Tool, Concept, SoftSkill
  isActive              Boolean                @default(true)
  careerSkills          CareerSkill[]
  prerequisites         SkillPrerequisite[]    @relation("SkillToPrerequisites") // Skills that THIS skill requires
  dependents            SkillPrerequisite[]    @relation("PrerequisiteToSkills") // Skills that require THIS skill
  gapResults            SkillGapResult[]
  resourceSkills        ResourceSkill[]
  resourcePrerequisites ResourcePrerequisite[]
  recommendations       Recommendation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([category])
  @@index([slug])
  @@index([skillType])
}

model CareerSkill {
  id            String   @id @default(uuid())
  careerId      String
  career        Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  importance    String   @default("HIGH") // CORE, HIGH, MEDIUM, OPTIONAL
  requiredLevel Int      @default(3) // 1 to 5: 1=Beginner, 2=Basic, 3=Intermediate, 4=Advanced, 5=Expert
  priority      Int      @default(1)
  rationale     String?
  isCore        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([careerId, skillId])
  @@index([careerId])
  @@index([skillId])
  @@index([importance])
}

model SkillPrerequisite {
  id                  String   @id @default(uuid())
  skillId             String
  skill               Skill    @relation("SkillToPrerequisites", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisiteSkillId String
  prerequisiteSkill   Skill    @relation("PrerequisiteToSkills", fields: [prerequisiteSkillId], references: [id], onDelete: Cascade)
  strength            String   @default("REQUIRED") // REQUIRED, RECOMMENDED, HELPFUL
  rationale           String?
  createdAt           DateTime @default(now())

  @@unique([skillId, prerequisiteSkillId])
  @@index([skillId])
  @@index([prerequisiteSkillId])
}

// ==============================================================================
// PHASE 3: PERSONALIZED SKILL GAP INTELLIGENCE ENGINE
// ==============================================================================

model SkillGapAnalysis {
  id               String           @id @default(uuid())
  userId           String
  learnerProfileId String
  learnerProfile   LearnerProfile   @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  careerId         String
  career           Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)
  readinessScore   Float            // 0.0 to 100.0 alignment percentage
  readinessBand    String           // Starting Point, Early Development, Developing, Strong Progress, Career Ready
  algorithmVersion String           @default("v1")
  summary          String?
  stats            String?          // JSON stringified summary counts
  results          SkillGapResult[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([learnerProfileId])
  @@index([careerId])
}

model SkillGapResult {
  id                    String           @id @default(uuid())
  analysisId            String
  analysis              SkillGapAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  skillId               String
  skill                 Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  learnerLevel          Int              // 0 to 5
  requiredLevel         Int              // 1 to 5
  gap                   Int              // max(0, requiredLevel - learnerLevel)
  gapSeverity           Float            // 0.0 to 1.0
  importance            String           // CORE, HIGH, MEDIUM, OPTIONAL
  priorityScore         Float            // 0.0 to 1.0
  readiness             String           // READY, PARTIALLY_READY, BLOCKED
  category              String           // STRENGTH, DEVELOPING, MISSING
  isCritical            Boolean          @default(false)
  explanation           String
  downstreamImpactCount Int              @default(0)
  createdAt             DateTime         @default(now())

  @@index([analysisId])
  @@index([skillId])
}

// ==============================================================================
// PHASE 4: INTELLIGENT LEARNING RESOURCE RECOMMENDATION ENGINE
// ==============================================================================

model LearningResource {
  id             String                 @id @default(uuid())
  title          String
  slug           String                 @unique
  description    String
  resourceType   String                 // COURSE, PROJECT, ARTICLE, DOCUMENTATION, VIDEO, BOOK, EXERCISE
  provider       String                 // e.g., MDN, Spring.io, freeCodeCamp, MIT OCW, Coursera
  url            String                 // Realistic canonical educational link
  difficulty     String                 // BEGINNER, INTERMEDIATE, ADVANCED
  estimatedHours Float                  @default(5.0)
  language       String                 @default("en")
  isFree         Boolean                @default(true)
  qualityScore   Float                  @default(0.85) // Internal curated quality score 0.0 to 1.0
  embedding      String?                // JSON stringified float[] vector
  isActive       Boolean                @default(true)
  skills         ResourceSkill[]
  prerequisites  ResourcePrerequisite[]
  recommendations Recommendation[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([resourceType])
  @@index([difficulty])
  @@index([isFree])
  @@index([isActive])
}

model ResourceSkill {
  id         String           @id @default(uuid())
  resourceId String
  resource   LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  coverage   String           @default("PRIMARY") // PRIMARY, SUPPORTING, MENTIONED
  createdAt  DateTime         @default(now())

  @@unique([resourceId, skillId])
  @@index([resourceId])
  @@index([skillId])
  @@index([coverage])
}

model ResourcePrerequisite {
  id            String           @id @default(uuid())
  resourceId    String
  resource      LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  requiredLevel Int              @default(2) // Minimum level (1-5) required for this resource
  createdAt     DateTime         @default(now())

  @@unique([resourceId, skillId])
  @@index([resourceId])
  @@index([skillId])
}

model Recommendation {
  id                 String           @id @default(uuid())
  userId             String
  learnerProfileId   String
  learnerProfile     LearnerProfile   @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  careerId           String
  career             Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  resourceId         String
  resource           LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  semanticScore      Float            // 0.0 to 1.0
  coverageScore      Float            // 0.0 to 1.0
  careerScore        Float            // 0.0 to 1.0
  difficultyScore    Float            // 0.0 to 1.0
  prerequisiteScore  Float            // 0.0 to 1.0
  preferenceScore    Float            // 0.0 to 1.0
  qualityScore       Float            // 0.0 to 1.0
  finalScore         Float            // 0.0 to 1.0
  matchPercentage    Int              // 0 to 100
  rank               Int              // 1, 2, 3...
  explanation        String           // JSON stringified string[]
  isSemanticFallback Boolean          @default(false)
  algorithmVersion   String           @default("recommendation-v1")
  createdAt          DateTime         @default(now())

  @@index([userId])
  @@index([learnerProfileId])
  @@index([careerId])
  @@index([skillId])
  @@index([resourceId])
}

